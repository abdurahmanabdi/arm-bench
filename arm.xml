<mujoco model="mini_arm_grasp">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <default>
    <joint damping="1.5" frictionloss="0.05"/>
    <geom friction="1.2 0.02 0.001" solref="0.01 1" condim="4"/>
    <position kp="60" ctrlrange="-3.14 3.14"/>
    <default class="finger">
      <joint type="slide" range="0 0.045" damping="8"/>
      <position kp="400" ctrlrange="0 0.045"/>
    </default>
    <default class="noncollide">
      <geom contype="0" conaffinity="0"/>
    </default>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.75 0.82 0.92" rgb2="0.95 0.96 0.98" width="256" height="256"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.85 0.85 0.85" rgb2="0.7 0.7 0.7" width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="4 4" reflectance="0.05"/>
    <material name="table_mat" rgba="0.55 0.4 0.28 1"/>
    <material name="arm_mat" rgba="0.2 0.45 0.75 1"/>
    <material name="finger_mat" rgba="0.15 0.15 0.15 1"/>
    <material name="cube_mat" rgba="0.85 0.2 0.15 1"/>
    <material name="cube_b_mat" rgba="0.2 0.35 0.85 1"/>
    <material name="target_mat" rgba="0.15 0.75 0.3 0.35"/>
  </asset>

  <worldbody>
    <camera name="front" pos="0.25 -1.15 0.95" xyaxes="1 0 0 0 0.6 0.75"/>
    <light pos="0 -0.3 1.5" dir="0.1 0.2 -1" diffuse="0.9 0.9 0.85" specular="0.2 0.2 0.2"/>
    <light pos="0.6 0.6 1.2" dir="-0.3 -0.3 -1" diffuse="0.4 0.4 0.4"/>
    <geom name="floor" type="plane" size="1.2 1.2 0.1" material="grid"/>

    <!-- table -->
    <body name="table" pos="0.42 0 0.15">
      <geom type="box" size="0.28 0.32 0.15" material="table_mat"/>
    </body>

    <!-- rack slot markers: two well-separated placement zones (stand-in for dishwasher slots) -->
    <site name="slot_a_site" pos="0.52 -0.20 0.301" size="0.05 0.05 0.001" type="box" rgba="0.85 0.55 0.1 0.4"/>
    <site name="slot_b_site" pos="0.52 0.20 0.301" size="0.05 0.05 0.001" type="box" rgba="0.15 0.75 0.3 0.4"/>

    <!-- cube A: placed first, becomes the base of the stack -->
    <body name="cube_a" pos="0.42 -0.15 0.335">
      <freejoint name="cube_a_free"/>
      <geom name="cube_a_geom" type="box" size="0.022 0.022 0.022" material="cube_mat" mass="0.03"/>
    </body>

    <!-- cube B: placed second, stacked on top of cube A -->
    <body name="cube_b" pos="0.42 0.05 0.335">
      <freejoint name="cube_b_free"/>
      <geom name="cube_b_geom" type="box" size="0.022 0.022 0.022" material="cube_b_mat" mass="0.03"/>
    </body>

    <!-- arm base -->
    <body name="base" pos="0 0 0.05">
      <geom type="cylinder" size="0.06 0.05" material="arm_mat" class="noncollide"/>
      <body name="link1" pos="0 0 0.05">
        <joint name="base_yaw" type="hinge" axis="0 0 1" range="-3.0 3.0"/>
        <geom type="capsule" fromto="0 0 0 0 0 0.08" size="0.035" material="arm_mat" class="noncollide"/>
        <body name="link2" pos="0 0 0.08">
          <joint name="shoulder_pitch" type="hinge" axis="0 1 0" range="-1.6 1.6"/>
          <geom type="capsule" fromto="0 0 0 0.28 0 0" size="0.03" material="arm_mat" class="noncollide"/>
          <body name="link3" pos="0.28 0 0">
            <joint name="elbow_pitch" type="hinge" axis="0 1 0" range="-2.6 0.2"/>
            <geom type="capsule" fromto="0 0 0 0.24 0 0" size="0.026" material="arm_mat" class="noncollide"/>
            <body name="link4" pos="0.24 0 0">
              <joint name="wrist_pitch" type="hinge" axis="0 1 0" range="-2.0 2.0"/>
              <geom type="capsule" fromto="0 0 0 0.09 0 0" size="0.02" material="arm_mat" class="noncollide"/>
              <body name="gripper_base" pos="0.09 0 0">
                <geom type="box" size="0.02 0.05 0.025" material="finger_mat" class="noncollide"/>
                <site name="ee_site" pos="0.06 0 0" size="0.008" rgba="1 1 0 1"/>
                <body name="finger_l" pos="0.02 0.024 0">
                  <joint name="finger_l_joint" class="finger" axis="0 1 0"/>
                  <geom type="box" size="0.035 0.008 0.018" pos="0.035 0 0" material="finger_mat" friction="1.8 0.03 0.002"/>
                </body>
                <body name="finger_r" pos="0.02 -0.024 0">
                  <joint name="finger_r_joint" class="finger" axis="0 -1 0"/>
                  <geom type="box" size="0.035 0.008 0.018" pos="0.035 0 0" material="finger_mat" friction="1.8 0.03 0.002"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="a_base_yaw" joint="base_yaw"/>
    <position name="a_shoulder" joint="shoulder_pitch"/>
    <position name="a_elbow" joint="elbow_pitch"/>
    <position name="a_wrist" joint="wrist_pitch"/>
    <position name="a_finger_l" joint="finger_l_joint" class="finger"/>
    <position name="a_finger_r" joint="finger_r_joint" class="finger"/>
  </actuator>
</mujoco>
